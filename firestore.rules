rules_version = '2';
// Regras da comunidade Latitude 53.
// Perfis, publicações, comentários e quem segue quem são públicos para leitura.
// Cada pessoa só altera o que é dela. Autores (coleção "admins") podem apagar comentários.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function verified() {
      return signedIn() && (request.auth.token.email_verified == true
        || request.auth.token.firebase.sign_in_provider == 'google.com');
    }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function str(v, max) { return v is string && v.size() <= max; }

    match /admins/{uid} {
      allow read: if true;
      allow write: if false;            // criado à mão no console do Firebase
    }

    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['nome','insta','cidade','bio','paises','foto','avatar','cidades','proximo','criadoEm'])
        && str(request.resource.data.nome, 60) && request.resource.data.nome.size() > 0
        && str(request.resource.data.get('insta',''), 30)
        && str(request.resource.data.get('cidade',''), 60)
        && str(request.resource.data.get('bio',''), 280)
        && str(request.resource.data.get('foto',''), 500)
        && str(request.resource.data.get('avatar',''), 140000)
        && request.resource.data.get('paises', []) is list
        && request.resource.data.get('paises', []).size() <= 200
        && request.resource.data.get('cidades', []) is list
        && request.resource.data.get('cidades', []).size() <= 300
        && str(request.resource.data.get('proximo',''), 80);
      allow delete: if isMe(uid);
    }

    match /follows/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from','to','em'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to;
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow update: if false;
    }

    match /comments/{id} {
      allow read: if true;
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['alvo','alvoTitulo','uid','nome','texto','em'])
        && request.resource.data.uid == request.auth.uid
        && str(request.resource.data.alvo, 80) && request.resource.data.alvo.matches('^(dia|lugar|post):[A-Za-z0-9_-]+$')
        && str(request.resource.data.alvoTitulo, 120)
        && str(request.resource.data.nome, 60)
        && str(request.resource.data.texto, 1000) && request.resource.data.texto.size() > 0
        && request.resource.data.em == request.time;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if false;
    }

    match /posts/{id} {
      // tipo: post (publicação livre), dica ou checkin. Posts antigos não têm tipo e contam como dica.
      allow read: if true;
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['uid','nome','tipo','titulo','cidade','paisA2','texto','link','temFoto','lat','lng','em'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.get('tipo','dica') in ['post','dica','checkin']
        && str(request.resource.data.get('titulo',''), 100)
        && str(request.resource.data.nome, 60)
        && str(request.resource.data.get('cidade',''), 60)
        && str(request.resource.data.get('paisA2',''), 2)
        && str(request.resource.data.get('texto',''), 1500)
        && str(request.resource.data.get('link',''), 300)
        && request.resource.data.get('temFoto', false) is bool
        && (request.resource.data.get('titulo','').size() > 0
            || request.resource.data.get('texto','').size() > 0
            || request.resource.data.get('temFoto', false) == true
            || (request.resource.data.get('tipo','dica') == 'checkin' && request.resource.data.get('cidade','').size() > 0))
        && (!('lat' in request.resource.data) || (request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90))
        && (!('lng' in request.resource.data) || (request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180))
        && request.resource.data.em == request.time;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if false;
    }

    match /fotos/{id} {
      allow read: if true;
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['uid','data'])
        && request.resource.data.uid == request.auth.uid
        && get(/databases/$(database)/documents/posts/$(id)).data.uid == request.auth.uid
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 400000
        && request.resource.data.data.matches('data:image/jpeg;base64,.*');
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // ---------- viagens compartilhadas ----------
    function validTrip(d) {
      return d.keys().hasOnly(['dono','membros','titulo','resumo','inicio','fim','publica','paradas','criadaEm','atualizadaEm'])
        && d.dono is string && d.membros is list
        && d.membros.size() >= 1 && d.membros.size() <= 8 && d.dono in d.membros
        && str(d.titulo, 80) && d.titulo.size() > 0
        && str(d.get('resumo',''), 500)
        && str(d.get('inicio',''), 10) && str(d.get('fim',''), 10)
        && d.publica is bool
        && d.get('paradas', []) is list && d.get('paradas', []).size() <= 30;
    }
    function tripData(vid) { return get(/databases/$(database)/documents/viagens/$(vid)).data; }

    match /viagens/{vid} {
      allow read: if resource.data.publica == true || (signedIn() && request.auth.uid in resource.data.membros);
      allow create: if verified() && validTrip(request.resource.data)
        && request.resource.data.dono == request.auth.uid
        && request.resource.data.membros == [request.auth.uid];
      allow update: if signedIn() && validTrip(request.resource.data) && (
        // quem organiza pode tudo (inclusive remover pessoas ou passar a organização)
        request.auth.uid == resource.data.dono
        // participantes editam a viagem, sem mexer em quem participa
        || (request.auth.uid in resource.data.membros
            && request.resource.data.membros == resource.data.membros
            && request.resource.data.dono == resource.data.dono)
        // participante sai da viagem
        || (request.auth.uid in resource.data.membros
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros','atualizadaEm'])
            && request.resource.data.membros == resource.data.membros.removeAll([request.auth.uid]))
        // aceitar um convite
        || (!(request.auth.uid in resource.data.membros)
            && exists(/databases/$(database)/documents/convites/$(vid + '_' + request.auth.uid))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros','atualizadaEm'])
            && request.resource.data.membros == resource.data.membros.concat([request.auth.uid]))
      );
      allow delete: if signedIn() && request.auth.uid == resource.data.dono;

      match /dias/{did} {
        allow read: if tripData(vid).publica == true || (signedIn() && request.auth.uid in tripData(vid).membros);
        allow create, update: if signedIn() && request.auth.uid in tripData(vid).membros
          && request.resource.data.keys().hasOnly(['data','cidade','paisA2','titulo','plano','por','em'])
          && str(request.resource.data.get('data',''), 10)
          && str(request.resource.data.get('cidade',''), 60)
          && str(request.resource.data.get('paisA2',''), 2)
          && str(request.resource.data.get('titulo',''), 100)
          && str(request.resource.data.get('plano',''), 3000)
          && str(request.resource.data.get('por',''), 60);
        allow delete: if signedIn() && request.auth.uid in tripData(vid).membros;
      }
    }

    match /convites/{id} {
      allow read: if signedIn() && (resource.data.para == request.auth.uid || resource.data.de == request.auth.uid);
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['viagem','viagemTitulo','de','deNome','para','em'])
        && request.resource.data.de == request.auth.uid
        && request.resource.data.para is string && request.resource.data.para != request.auth.uid
        && request.resource.data.viagem is string
        && id == request.resource.data.viagem + '_' + request.resource.data.para
        && request.auth.uid in tripData(request.resource.data.viagem).membros
        && !(request.resource.data.para in tripData(request.resource.data.viagem).membros)
        && str(request.resource.data.viagemTitulo, 80)
        && str(request.resource.data.deNome, 60)
        && request.resource.data.em == request.time;
      allow delete: if signedIn() && (resource.data.para == request.auth.uid || resource.data.de == request.auth.uid);
      allow update: if false;
    }

    match /users/{uid}/salvos/{id} {
      allow read, delete: if isMe(uid);
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['alvo','titulo','em'])
        && str(request.resource.data.alvo, 80) && str(request.resource.data.titulo, 120);
    }

    match /{document=**} { allow read, write: if false; }
  }
}
